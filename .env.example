# Copy to .env and fill in. The app stops at startup with a message naming
# the variable if a required one is missing or invalid.

# Required: signs the login cookie. A long random value, e.g. from
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# Required: where changes are sent. Discord: channel settings → Integrations
# → Webhooks → New Webhook → Copy Webhook URL.
DISCORD_WEBHOOK_URL=

# How often to check every watch, in minutes. Default 30.
CHECK_INTERVAL_MINUTES=30

# The login, created on first start only (when the database has no account).
# The password is required until then; changing these later does nothing.
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=

# Port the app listens on. Default 3000.
PORT=3000

# Time zone for times shown in the app (Docker). Default Europe/Stockholm.
TZ=Europe/Stockholm

# Behind an HTTPS reverse proxy: true, so the login cookie is only sent over
# HTTPS. Default false.
COOKIE_SECURE=false

# Which proxy's X-Forwarded-For to trust: a number of hops, false, or
# addresses (e.g. loopback). Empty: one hop when COOKIE_SECURE=true, none
# otherwise. Only trust a proxy if the app can't be reached around it.
TRUST_PROXY=

# The image tag docker compose runs (e.g. v0.2.0). Default latest.
MATSMART_WATCHER_VERSION=latest
