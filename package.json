{
  "name": "matsmart-watcher",
  "version": "0.2.0",
  "private": true,
  "description": "Watches matsmart.se for products, stores their state, sends Discord alerts on changes. Express, EJS and SQLite in one Docker image.",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --test"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "ejs": "^3.1.10",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "express-session": "^1.18.1",
    "sqlite": "^5.1.1",
    "sqlite3": "^6.0.1"
  },
  "allowScripts": {
    "sqlite3@6.0.1": true
  }
}
